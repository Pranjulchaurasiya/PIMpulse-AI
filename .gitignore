# ============================================================
# PIMpulse AI - Git Ignore Rules
# ============================================================

# Environment variables & secrets (CRITICAL: Never commit real API keys)
.env
.env.local
.env.*.local
*.env
!.env.example

# Python cache & bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
env/
.venv/
ENV/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.hypothesis/

# IDE & OS metadata
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# Transient batch uploads & temporary working outputs
PIMpulse_Uploaded_Input.xlsx
PIMpulse_Uploaded_Enriched.xlsx
PIMpulse_Uploaded_Enriched.csv
*.log
scratch/
temp/
tmp/
