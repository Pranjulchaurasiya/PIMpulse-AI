
# ============================================================
# PIMpulse AI Configuration Template - UniHack 2026
# Copy this file to .env and fill in your actual API keys
# ============================================================

# Primary Provider: 'groq' (Recommended for ultra-fast LPU inference)
PROVIDER=groq

# Groq Cloud API Settings (Primary)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TEXT_MODEL=llama-3.1-8b-instant
GROQ_FAST_MODEL=llama-3.1-8b-instant
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview

# Web Search API (Tavily - Real-Time Technical Datasheet Search)
TAVILY_API_KEY=tvly-your_tavily_api_key_here

# Anthropic / Claude API Settings (Optional High-Reasoning Fallback)
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_BASE_URL=

# Vector Search (Optional Qdrant/In-Memory)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
SEMANTIC_CACHE_THRESHOLD=0.96
